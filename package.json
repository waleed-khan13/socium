{
  "name": "socium-app",
  "version": "1.2.0",
  "private": true,
  "description": "Open-source, localhost-only AI social publishing with human approval.",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.13.1",
      "nanoid": "3.3.18"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --webpack",
    "dev:api": "uv run --project backend uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "cli": "pnpm --filter socium socium",
    "cli:test": "pnpm --filter socium test",
    "broker:test": "pnpm --filter @socium/connect-broker test",
    "backend:sync": "uv sync --project backend",
    "backend:bundle": "uv run --directory backend pyinstaller --clean --noconfirm socium-api.spec",
    "backend:bundle:smoke": "node scripts/smoke-bundled-api.mjs",
    "native:build": "node scripts/build-native-helper.mjs",
    "backend:test": "uv run --directory backend pytest",
    "backend:lint": "uv run --directory backend ruff check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "release:bundle": "pnpm --filter socium bundle",
    "release:bundle:smoke": "node scripts/smoke-cli-bundle.mjs",
    "release:notes": "node scripts/write-release-notes.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "runtime:sync": "npm ci --omit=dev --ignore-scripts --prefix packaging/web-runtime",
    "check": "pnpm typecheck && pnpm lint && pnpm cli:test && pnpm broker:test && pnpm backend:lint && pnpm backend:test && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
