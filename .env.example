# Socium binds to loopback only. Do not expose these ports publicly.
PORT=3000
SOCIUM_API_PORT=8000

# Local database, master key, exports, and generated files.
# Native default: ./data
# Docker Compose mounts a named volume at /data for the API service.
SOCIUM_DATA_DIR=./data

# Optional separate directory for downloaded local-AI model files.
# Native installs normally choose this from onboarding or storage settings.
SOCIUM_MODELS_DIR=./models

# Used internally by the Next.js same-origin proxy.
SOCIUM_API_URL=http://127.0.0.1:8000

# Telegram uses outbound long polling; no domain, tunnel, or webhook secret is required.
SOCIUM_TELEGRAM_POLL_TIMEOUT=25

# Durable scheduler checks due work locally and catches up bounded overdue jobs after restart.
SOCIUM_SCHEDULER_INTERVAL=1
SOCIUM_SCHEDULER_CATCH_UP_HOURS=24
SOCIUM_SCHEDULER_STALE_MINUTES=10

# v1.0 ships the social publishing workspace by default. Enable unfinished
# Lead intelligence and Local SEO screens only when intentionally testing them.
SOCIUM_ENABLE_LABS=0

# AI provider and connector credentials are configured in the dashboard and encrypted at rest.
